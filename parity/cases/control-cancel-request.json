{
  "name": "control-cancel-request",
  "description": "The CLI cancels a permission request whose callback has not answered: neither SDK answers the cancelled request, and the session goes on to answer a hook callback sent after it.",
  "scenario": {
    "steps": [
      {
        "expect": {
          "type": "control_request",
          "request": {
            "subtype": "initialize"
          }
        }
      },
      {
        "control_response": {
          "commands": []
        }
      },
      {
        "expect": {
          "type": "user"
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "perm-1",
          "request": {
            "subtype": "can_use_tool",
            "tool_name": "Bash",
            "input": {
              "command": "npm test"
            },
            "permission_suggestions": [],
            "tool_use_id": "toolu_1"
          }
        }
      },
      {
        "sleep_ms": 500
      },
      {
        "emit": {
          "type": "control_cancel_request",
          "request_id": "perm-1"
        }
      },
      {
        "sleep_ms": 200
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "hook-1",
          "request": {
            "subtype": "hook_callback",
            "callback_id": "hook_0",
            "input": {
              "hook_event_name": "PreToolUse",
              "session_id": "s",
              "transcript_path": "/t/s.jsonl",
              "cwd": "/c",
              "permission_mode": "default",
              "tool_name": "Read",
              "tool_input": {
                "file_path": "/c/a.txt"
              },
              "tool_use_id": "toolu_2"
            },
            "tool_use_id": "toolu_2"
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "hook-1"
          }
        }
      },
      {
        "emit": {
          "type": "result",
          "subtype": "success",
          "duration_ms": 1,
          "duration_api_ms": 1,
          "is_error": false,
          "num_turns": 1,
          "session_id": "s",
          "result": "done"
        }
      }
    ]
  },
  "options": {
    "can_use_tool": {
      "behavior": "wait"
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Read",
          "hooks": [
            {
              "continue": true
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "connect": {}
    },
    {
      "query": {
        "prompt": "Go"
      }
    },
    {
      "receive_response": true
    },
    {
      "disconnect": true
    }
  ]
}
