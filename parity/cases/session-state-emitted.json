{
  "name": "session-state-emitted",
  "description": "The caller asks the CLI for session state events (CLAUDE_CODE_EMIT_SESSION_STATE_EVENTS in the env option), so the frames arrive unmarked and both SDKs hand them to the application as system messages.",
  "scenario": {
    "steps": [
      {
        "expect": {
          "type": "control_request",
          "request": {
            "subtype": "initialize"
          }
        }
      },
      {
        "control_response": {
          "commands": []
        }
      },
      {
        "expect": {
          "type": "user"
        }
      },
      {
        "session_state": "running"
      },
      {
        "emit": {
          "type": "assistant",
          "message": {
            "role": "assistant",
            "model": "m",
            "content": [
              {
                "type": "text",
                "text": "Working."
              }
            ]
          },
          "session_id": "s"
        }
      },
      {
        "emit": {
          "type": "result",
          "subtype": "success",
          "duration_ms": 1,
          "duration_api_ms": 1,
          "is_error": false,
          "num_turns": 1,
          "session_id": "s",
          "result": "done"
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "perm-1",
          "request": {
            "subtype": "can_use_tool",
            "tool_name": "Bash",
            "input": {
              "command": "npm test"
            },
            "permission_suggestions": [],
            "tool_use_id": "toolu_1"
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "perm-1"
          }
        }
      },
      {
        "session_state": "idle"
      }
    ]
  },
  "options": {
    "can_use_tool": {
      "behavior": "allow"
    },
    "env": {
      "CLAUDE_CODE_EMIT_SESSION_STATE_EVENTS": "1"
    }
  },
  "prompt": [
    {
      "type": "user",
      "message": {
        "role": "user",
        "content": "Go"
      }
    }
  ]
}
