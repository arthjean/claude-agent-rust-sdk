        "emit": {
          "type": "control_request",
          "request_id": "mcp-1",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "id": 1,
              "method": "tools/list"
            }
          }
        }
      },
