  "options": {
    "mcp_servers": {
      "calc": {
        "type": "sdk",
        "version": "2.0.0",
        "tools": [
          {
            "name": "add",
            "description": "Add two numbers",
            "input_schema": {
              "type": "object",
              "properties": {
                "a": {
                  "type": "number"
                },
                "b": {
                  "type": "number"
                }
              },
              "required": [
                "a",
                "b"
              ]
            },
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "3"
                }
              ]
            }
          }
        ]
