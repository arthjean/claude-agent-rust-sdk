{
  "name": "mcp-cancel",
  "description": "The CLI cancels a running in-process tool call with notifications/cancelled: the call is answered with the cancellation error.",
  "scenario": {
    "steps": [
      {
        "expect": {
          "type": "control_request",
          "request": {
            "subtype": "initialize"
          }
        }
      },
      {
        "control_response": {
          "commands": []
        }
      },
      {
        "expect": {
          "type": "user"
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "mcp-1",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "id": 0,
              "method": "initialize",
              "params": {
                "protocolVersion": "2025-11-25",
                "capabilities": {},
                "clientInfo": {
                  "name": "claude-code",
                  "version": "2.1.329"
                }
              }
            }
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "mcp-1"
          }
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "mcp-2",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "id": 2,
              "method": "tools/call",
              "params": {
                "name": "wait",
                "arguments": {}
              }
            }
          }
        }
      },
      {
        "sleep_ms": 300
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "mcp-3",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "method": "notifications/cancelled",
              "params": {
                "requestId": 2,
                "reason": "user"
              }
            }
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "mcp-3"
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "mcp-2"
          }
        }
      },
      {
        "emit": {
          "type": "result",
          "subtype": "success",
          "duration_ms": 1,
          "duration_api_ms": 1,
          "is_error": false,
          "num_turns": 1,
          "session_id": "s",
          "result": "done"
        }
      }
    ]
  },
  "options": {
    "mcp_servers": {
      "calc": {
        "type": "sdk",
        "version": "2.0.0",
        "tools": [
          {
            "name": "wait",
            "description": "Never returns",
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "wait": true
          }
        ]
      }
    }
  },
  "steps": [
    {
      "connect": {}
    },
    {
      "query": {
        "prompt": "Go"
      }
    },
    {
      "receive_response": true
    },
    {
      "disconnect": true
    }
  ],
  "unordered": [
    [
      "control_response:mcp-2",
      "control_response:mcp-3"
    ]
  ]
}
