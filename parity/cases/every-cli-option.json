{
  "name": "every-cli-option",
  "description": "A one-shot query with every option of the first driver set that reaches the command line or the environment.",
  "scenario": "one-shot",
  "options": {
    "system_prompt": "You are terse.",
    "tools": ["Read", "Bash"],
    "allowed_tools": ["Read", "Bash(git status)"],
    "disallowed_tools": ["Write", "WebFetch"],
    "max_turns": 3,
    "max_budget_usd": 2.0,
    "model": "claude-sonnet-5-5",
    "fallback_model": "claude-haiku-5-5",
    "permission_mode": "acceptEdits",
    "continue_conversation": true,
    "resume": "11111111-2222-4333-8444-555555555555",
    "session_id": "66666666-7777-4888-8999-000000000000",
    "settings": "{\"permissions\": {\"allow\": [\"Read\"]}}",
    "add_dirs": ["${WORK}/extra", "${WORK}/more"],
    "mcp_servers": {
      "local": {"type": "stdio", "command": "node", "args": ["server.js"], "env": {"TOKEN": "t"}},
      "remote": {"type": "http", "url": "https://example.invalid/mcp", "headers": {"Authorization": "Bearer x"}}
    },
    "include_partial_messages": true,
    "setting_sources": ["user", "project"],
    "extra_args": {"replay-user-messages": null, "debug-file": "${WORK}/debug.log"},
    "thinking": {"type": "enabled", "budget_tokens": 2048},
    "effort": "high",
    "output_format": {"type": "json_schema", "schema": {"type": "object", "properties": {"answer": {"type": "string"}}, "required": ["answer"]}},
    "env": {"CLAUDE_PARITY_CASE": "every-cli-option", "ANTHROPIC_BASE_URL": "http://127.0.0.1:9"},
    "cwd": "${WORK}"
  },
  "prompt": "Say hello"
}
