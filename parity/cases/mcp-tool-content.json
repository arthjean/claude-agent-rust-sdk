{
  "name": "mcp-tool-content",
  "description": "An in-process MCP server lists tools with annotations, an empty description, and schemas with keys MCP does not model, and answers calls with every content kind, a handler that fails, and no content.",
  "scenario": {
    "steps": [
      {
        "expect": {
          "type": "control_request",
          "request": {
            "subtype": "initialize"
          }
        }
      },
      {
        "control_response": {
          "commands": []
        }
      },
      {
        "expect": {
          "type": "user"
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "mcp-1",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "id": 0,
              "method": "initialize",
              "params": {
                "protocolVersion": "2025-11-25",
                "capabilities": {},
                "clientInfo": {
                  "name": "claude-code",
                  "version": "2.1.329"
                }
              }
            }
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "mcp-1"
          }
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "mcp-2",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "id": 2,
              "method": "tools/list"
            }
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "mcp-2"
          }
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "mcp-3",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "id": 3,
              "method": "tools/call",
              "params": {
                "name": "look",
                "arguments": {
                  "b": "x"
                }
              }
            }
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "mcp-3"
          }
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "mcp-4",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "id": 4,
              "method": "tools/call",
              "params": {
                "name": "broken",
                "arguments": {}
              }
            }
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "mcp-4"
          }
        }
      },
      {
        "emit": {
          "type": "control_request",
          "request_id": "mcp-5",
          "request": {
            "subtype": "mcp_message",
            "server_name": "calc",
            "message": {
              "jsonrpc": "2.0",
              "id": 5,
              "method": "tools/call",
              "params": {
                "name": "empty",
                "arguments": {}
              }
            }
          }
        }
      },
      {
        "expect": {
          "type": "control_response",
          "response": {
            "request_id": "mcp-5"
          }
        }
      },
      {
        "emit": {
          "type": "result",
          "subtype": "success",
          "duration_ms": 1,
          "duration_api_ms": 1,
          "is_error": false,
          "num_turns": 1,
          "session_id": "s",
          "result": "done"
        }
      }
    ]
  },
  "options": {
    "mcp_servers": {
      "calc": {
        "type": "sdk",
        "version": "2.0.0",
        "tools": [
          {
            "name": "look",
            "description": "Returns every kind of content",
            "input_schema": {
              "type": "object",
              "properties": {
                "b": {
                  "type": "string",
                  "description": "second"
                },
                "a": {
                  "type": "number"
                }
              },
              "required": [
                "b"
              ],
              "additionalProperties": false,
              "$defs": {
                "z": {}
              }
            },
            "annotations": {
              "title": "Looker",
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false
            },
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "plain"
                },
                {
                  "type": "image",
                  "data": "aGk=",
                  "mimeType": "image/png"
                },
                {
                  "type": "resource_link",
                  "name": "doc",
                  "uri": "file:///doc",
                  "description": "a document"
                },
                {
                  "type": "resource",
                  "resource": {
                    "uri": "file:///t",
                    "text": "inline text",
                    "mimeType": "text/plain"
                  }
                },
                {
                  "type": "resource",
                  "resource": {
                    "uri": "file:///b",
                    "blob": "AAEC",
                    "mimeType": "application/octet-stream"
                  }
                }
              ]
            }
          },
          {
            "name": "broken",
            "description": "Raises",
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "raise": "the handler failed"
          },
          {
            "name": "empty",
            "description": "",
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "result": {
              "content": []
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "connect": {}
    },
    {
      "query": {
        "prompt": "Go"
      }
    },
    {
      "receive_response": true
    },
    {
      "disconnect": true
    }
  ]
}
