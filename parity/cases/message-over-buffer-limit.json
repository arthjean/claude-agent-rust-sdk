{
  "name": "message-over-buffer-limit",
  "description": "A message longer than max_buffer_size: each SDK stops reading and raises a JSON decode error instead of buffering without bound.",
  "scenario": {
    "steps": [
      {
        "expect": {
          "type": "control_request",
          "request": {
            "subtype": "initialize"
          }
        }
      },
      {
        "control_response": {
          "commands": []
        }
      },
      {
        "expect": {
          "type": "user"
        }
      },
      {
        "emit": {
          "type": "assistant",
          "session_id": "s",
          "message": {
            "role": "assistant",
            "model": "m",
            "content": [
              {
                "type": "text",
                "text": ""
              }
            ]
          }
        }
      },
      {
        "emit": {
          "type": "result",
          "subtype": "success",
          "duration_ms": 1,
          "duration_api_ms": 1,
          "is_error": false,
          "num_turns": 1,
          "session_id": "s",
          "result": "done"
        }
      }
    ]
  },
  "options": {
    "max_buffer_size": 2048
  },
  "prompt": "Go",
  "expect_error": true
}
